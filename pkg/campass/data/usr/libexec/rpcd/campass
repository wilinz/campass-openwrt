#!/bin/sh
# rpcd 插件: 暴露 ubus 对象 "campass"
# 注意: switch 可能耗时 2 分钟以上(登录+探测验证+回滚), 远超 ubus 调用超时,
# 所以后台拉起, 立刻返回当前进度; LuCI 轮询 switchstatus 看结果。
case "$1" in
	list)
		echo '{ "status": {}, "login": {}, "logout": {}, "unbind": {}, "log": {}, "clearlog": {}, "accounts": {}, "switch": { "section": "str" }, "switchstatus": {}, "probe": {}, "auth": {}, "clearauth": {} }'
		;;
	call)
		case "$2" in
			status)
				/usr/bin/campass status
				;;
			login)
				/usr/bin/campass login >/dev/null 2>&1
				/usr/bin/campass status
				;;
			logout)
				/usr/bin/campass logout >/dev/null 2>&1
				/usr/bin/campass status
				;;
			unbind)
				/usr/bin/campass unbind >/dev/null 2>&1
				/usr/bin/campass status
				;;
			accounts)
				/usr/bin/campass accounts
				;;
			switch)
				# 入参 JSON 从 stdin 读: { "section": "xxx" }
				. /usr/share/libubox/jshn.sh
				json_load "$(cat)" 2>/dev/null
				json_get_var sec section
				if [ -z "$sec" ]; then
					echo '{ "error": "missing section" }'
				else
					if command -v setsid >/dev/null 2>&1; then
						setsid /usr/bin/campass switch "$sec" >/dev/null 2>&1 &
					else
						( /usr/bin/campass switch "$sec" >/dev/null 2>&1 & ) &
					fi
					# 等一下, 让引擎写出初始进度再返回
					sleep 1
					/usr/bin/campass switchstatus
				fi
				;;
			switchstatus)
				/usr/bin/campass switchstatus
				;;
			probe)
				# v6 是黑洞时要等连接/读超时, 可能十几秒
				/usr/bin/campass probe
				;;
			auth)
				/usr/bin/campass auth
				;;
			clearauth)
				/usr/bin/campass clearauth
				;;
			*)
				echo '{}'
				;;
		esac
		;;
esac
