#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

FW_SEC="campass_block"

# 同步防火墙规则: block_lan=1 时禁止 LAN 用户访问认证网关,
# 防止局域网内其他人自行登出/换绑/篡改认证。路由器自身访问网关
# 走 host OUTPUT(非 lan 转发链), 不受此规则影响。
sync_firewall() {
	local block gw zone
	block=$(uci -q get campass.global.block_lan)
	gw=$(uci -q get campass.global.gateway)
	[ -z "$gw" ] && gw="10.0.1.5"
	zone=$(uci -q get campass.global.block_zone)
	[ -z "$zone" ] && zone="lan"

	if [ "$block" = "1" ]; then
		uci -q batch <<-EOF
			set firewall.$FW_SEC=rule
			set firewall.$FW_SEC.name='Campass-block-auth'
			set firewall.$FW_SEC.src='$zone'
			set firewall.$FW_SEC.dest='*'
			set firewall.$FW_SEC.dest_ip='$gw'
			set firewall.$FW_SEC.proto='all'
			set firewall.$FW_SEC.target='REJECT'
			set firewall.$FW_SEC.enabled='1'
		EOF
		uci commit firewall
		/etc/init.d/firewall reload >/dev/null 2>&1
	else
		if uci -q get firewall.$FW_SEC >/dev/null 2>&1; then
			uci -q delete firewall.$FW_SEC
			uci commit firewall
			/etc/init.d/firewall reload >/dev/null 2>&1
		fi
	fi
}

start_service() {
	config_load campass

	# 防火墙规则独立于服务启用状态, 每次都同步
	sync_firewall

	[ "$(uci -q get campass.global.enabled)" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/campass daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "campass"
}

reload_service() {
	stop
	start
}
